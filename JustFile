
set shell := ["bash", "-cu"]
set dotenv-load
venv := "source .venv/bin/activate"  

default:
  just --list

setup:
    sudo apt update && sudo apt install ffmpeg && uv sync

frontend:
   {{venv}} && streamlit run Application/Frontend/app.py

backend:
    {{venv}} && uv run fastapi run Application/Backend/fast_api_server.py

run:
    just backend & just frontend

documentation:
    {{venv}} && uv run mkdocs serve
 

